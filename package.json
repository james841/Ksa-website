{
  "name": "ksa-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "create-admin": "tsx --env-file=.env scripts/create-admin.ts",
    "setup": "npm run db:migrate && npm run db:seed && npm run db:check",
    "db:check": "tsx --env-file=.env scripts/db-check.ts",
    "storage:upload": "tsx --env-file=.env scripts/storage-upload.ts",
    "postinstall": "next typegen || exit 0"
  },
  "dependencies": {
    "@next/third-parties": "^16.4.5",
    "drizzle-orm": "^0.45.4",
    "marked": "^18.1.2",
    "motion": "^14.8.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.35.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
