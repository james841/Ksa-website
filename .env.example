# ─── Site ────────────────────────────────────────────────────────────
# Your public address. Used for SEO (canonical links, sitemap) and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database (PostgreSQL, the same server you open in pgAdmin) ─────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/ksa
# Set to true when your hosted database requires SSL (Supabase, Neon, Render...)
DATABASE_SSL=false

# On Supabase, DATABASE_URL above is the POOLED connection (port 6543) that the
# website uses, and this is the DIRECT one (port 5432) used by npm run db:migrate.
# Leave empty when the database is on your own computer.
DIRECT_DATABASE_URL=

# ─── Email (Resend) ─────────────────────────────────────────────────
# Create a key at https://resend.com/api-keys and verify your domain first.
RESEND_API_KEY=
# Must be an address on the domain you verified in Resend.
EMAIL_FROM="Knowledge Space Academy <hello@yourdomain.com>"
# Where new quote request alerts are sent.
ADMIN_NOTIFY_EMAIL=you@yourdomain.com
# Optional: Resend webhook signing secret (starts with whsec_) for bounce tracking.
RESEND_WEBHOOK_SECRET=

# ─── Security ───────────────────────────────────────────────────────
# Any long random string. Protects the scheduled-campaign endpoint.
CRON_SECRET=change-me-to-a-long-random-string

# ─── First admin account (used by `npm run create-admin`) ───────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_NAME=KSA Admin

# ─── File storage ───────────────────────────────────────────────────
# Folder where uploaded images and private course files are stored on your
# computer or on a normal server.
STORAGE_DIR=./storage

# Hosts like Vercel do not keep uploaded files, so there they go to Supabase
# Storage instead. Fill these in and uploads switch over automatically.
# Project settings > Data API > Project URL, and Project settings > API keys.
# The service role key is a password: keep it out of the browser and out of git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ksa-files

# ─── Course payments (PayFast, South Africa) ────────────────────────
# From your PayFast dashboard: Settings > Integration.
# Leave these empty and paid courses simply show "Contact us to enrol".
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# The passphrase you set in PayFast. Required for the signature to match.
PAYFAST_PASSPHRASE=

NEXT_PUBLIC_ADMIN_TIMEZONE=Africa/Lagos
